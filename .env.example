# Neo4j Code Graph Connection (read-only execution recommended)
NEO4J_URI=bolt://<host>:<port>
NEO4J_USER=<readonly_user>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SEC=5.0

# Approved LLM Providers ONLY: deepseek | glm | kimi
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SEC=25.0

# Supply API key for your chosen approved provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Execution & Resource Budgets (Appendix C)
DEFAULT_MAX_HOPS=6
HARD_MAX_HOPS=10
MAX_REPAIR_ROUNDS=2
SINGLE_QUERY_BUDGET_SEC=30.0
BATCH_MAX_SIZE=50
BATCH_CONCURRENCY=2
DISPLAY_MAX_NODES=100
DISPLAY_MAX_EDGES=500

# Storage
SQLITE_DB_PATH=data/app.db
SCHEMA_SNAPSHOT_PATH=data/schema_snapshot.json
KB_SEED_PATH=data/kb30.json
GOLDEN_SET_PATH=data/golden30.json
SKILLS_DIR=skills
